# CANONICAL mia-dsv41/.env for the gx10-01 (head) / gx10-02 (worker) cluster.
# Tracked copy of the untracked runtime file the Mia kit sources
# (<gx-server>/mia-dsv41/.env). Restore procedure: RECOVERY.md "Kit .env".
# Rules (D-049, D-051):
#  - NEVER pin HEAD_GID / WORKER_GID here. The kit sources this file after the
#    orchestrator's env, so a pin overrides the live per-rank RoCE v2 GID
#    resolution, and the kernel moves the index across reboots. The
#    orchestrator refuses to start (fabric_config) when a pin disagrees.
#  - DSV41_BOOT_MARGIN_GIB=6 / GPU_MEM_UTIL=0.85 are the measured
#    resident-desktop envelope in production since 2026-10-15 08:13Z (kit
#    default 12 / 0.88 is headless). Changing the guard is an owner decision.
# ----------------------------------------------------------------------------
# GX cluster topology — head gx10-01, worker gx10-02 (legenex). Pinned Mia commit 6f7d1590ad49a2b8995188e45d7b9db31e677452.
MODEL_HOST=/srv/models/dsv41/uncensored
ENGRAM_DIR=/srv/models/dsv41/engram-src
HF_MODEL_REPO=dealignai/DeepSeek-V4.1-Flash-UNCENSORED-EXL3-2.9bpw
HF_ENGRAM_REPO=deepseek-ai/DeepSeek-V4.1-Flash
HEAD_IP=192.168.100.10
WORKER_IP=192.168.100.11
WORKER_USER=legenex-02
WORKER_HOME=/home/legenex-02
# fabric addresses refuse SSH on this cluster; management SSH goes over the LAN
WORKER_SSH=legenex-02@10.60.21.41
WORKER_MODEL_DIR=/srv/models/dsv41/model
WORKER_ENGRAM_DIR=/srv/models/dsv41/engram-src
WEIGHT_SYNC=nfs
IMAGE_SHIP=rsync
PORT=8888
TP=2
NNODES=2
MASTER_PORT=29521
QUANTIZATION=exl3
SERVED_MODEL_NAME=DeepSeek-v4.1-Flash-EXL3
SPEC_METHOD=dspark
DSPARK_TOKENS=3
MAX_MODEL_LEN=600000
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=1536
# GPU_MEM_UTIL: kit default 0.88 (headless boot); 0.85 variant only for resident-session attempts
KV_CACHE_MEMORY_BYTES=2684354560
KV_BLOCK_SIZE=64
PREFIX_CACHE_RETENTION_INTERVAL=4096
LANGUAGE_MODEL_ONLY=0
DSV41_IO_THREADS=96
# Active CX7 rail-1 HCA on this cluster (fabric test evidence 2026-09-27):
# rail1 = enp1s0f0np0 / rocep1s0f0 on both nodes; rail2 = enP2p1s0f0np0 / roceP2p1s0f0.
# NCCL uses both; this pins the kit's GID sanity check to a populated HCA.
HEAD_CX7_IF=enp1s0f0np0
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f0
WORKER_CX7_IB=rocep1s0f0
# HEAD_GID / WORKER_GID are deliberately NOT pinned here: this file is sourced
# after the caller's env, so a pin overrides the orchestrator's live per-rank
# RoCE v2 GID resolution (D-049, D-051). The kernel moves the index across reboots.

# --- Boot-fit adjustments (2026-09-27, measured head node, user session resident) ---
# vLLM init saw 102.2 GiB free vs 107.03 required at 0.88. Fits: weights 99.5 +
# KV 2.5 + ~1.5 workspace = ~103.5G -> utilization 0.86 (104.6G target) with the
# auxiliary services stopped at boot and 63G swap backing idle desktop pages.
GPU_MEM_UTIL=0.85
# Measured environment: 12G default margin blocks boot with the desktop resident;
# 6G keeps the load within the observed envelope (post-load ~3.5-5G + swap).
# DSV41_BOOT_MARGIN_GIB: kit default 12 (headless). 6G is the measured
# resident-desktop envelope so gx-auto can boot without killing Wayland.
DSV41_BOOT_MARGIN_GIB=6
# NFS weight backend (kit default): worker streams weights over the fabric from
# the head export; no local copy needed (the rsync copy stays as fallback cache).
NFS_CLIENTS=192.168.100.11
