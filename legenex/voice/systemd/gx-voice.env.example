# ~/.config/gx-voice/gx-voice.env on gx10-02 -- NOT tracked. No secrets here:
# the API key is read from /srv/projects/gx-cluster/secrets/gx-voice/api-key (0600).
GX_VOICE_ORCHESTRATOR_DIR=/home/legenex-02/Documents/Projects/Server/gx-cluster/legenex/orchestrator
GX_VOICE_BINDS=127.0.0.1,192.168.100.11

# Optional overrides (code defaults shown; every variable is in gx_voice/config.py):
#GX_VOICE_PORT=18830
#GX_VOICE_ENGINE_PORT=18831              # always published on 127.0.0.1 only
#GX_VOICE_IMAGE=gx-voice-engine:qwen3tts-022e286-t214
#GX_VOICE_MODELS_DIR=/srv/models/voice
#GX_VOICE_DATA_ROOT=/srv/models/voice-data
#GX_VOICE_ENGINE_ESTIMATE_GIB=12         # measured; may be raised, never below 4
#GX_VOICE_MAX_RESIDENT=1                 # resident model variants (1-3); each adds ~4.5 GiB
#GX_VOICE_IDLE_UNLOAD_S=600
#GX_VOICE_EVICT_IDLE_PEERS=1             # idle ComfyUI weights / idle gx-music via their own paths
#GX_GUARD_RESERVE_GIB=30                 # can be raised, never lowered below 30
