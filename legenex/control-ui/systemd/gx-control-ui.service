# ==============================================================================
# gx-control-ui.service — gx-cluster management web UI, node 1 (gx10-01).
#
# INSTALL / REPAIR (no root; idempotent):
#   legenex/control-ui/scripts/install.sh
#
# VERIFY:
#   systemctl --user status gx-control-ui.service
#   curl -sS http://127.0.0.1:8088/api/ready
#
# Small infrastructure, so it starts at boot. It never starts a model: model
# changes go through the orchestrator / llama-swap APIs on explicit request.
# @REPO@ is replaced by install.sh with the checkout path.
# ==============================================================================
[Unit]
Description=gx-cluster control UI (management web interface), node 1
After=network-online.target docker.service gx-orchestrator.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@/legenex/control-ui
# Upstream credentials (LiteLLM master key, llama-swap key, media key) come
# from the SAME ignored file the orchestrator uses. Nothing is copied.
EnvironmentFile=-@REPO@/legenex/gateway/.env
Environment=PYTHONUNBUFFERED=1
# Loopback + this host's Tailscale address. Never a wildcard (enforced in code).
Environment=GX_UI_HOSTS=127.0.0.1,tailscale
Environment=GX_UI_PORT=8088
Environment=GX_REPO_ROOT=@REPO@
ExecStartPre=@REPO@/legenex/control-ui/scripts/wait-for-tailscale.sh
ExecStart=/usr/bin/python3 -m gx_control_ui
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=append:/srv/logs/gx-control-ui/control-ui.log
StandardError=append:/srv/logs/gx-control-ui/control-ui.log

# Resource limits: this must never compete with a model for memory.
# 1G since D-034: media uploads (up to 150 MB), ZIP export and model-manager
# downloads are streamed through temporary files, but a video edit request
# still holds its source in memory while it is sent to gx10-02.
MemoryMax=1G
MemoryHigh=768M
CPUQuota=150%
TasksMax=256

# Hardening, mirroring gx-orchestrator.service. The UI reads /proc, /sys,
# the checkout and logs. It writes only:
#   * its own state, secrets and logs (plus the Git-sync log directory used by
#     the integrity audit it can run);
#   * the media library (D-034);
#   * /srv/models (Model Manager staging, install and approved removal) and the
#     Hugging Face token directory;
#   * the three reviewed binding files an alias assignment edits in place
#     (autosync then commits them) and the model registry directory.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/logs /srv/projects/gx-cluster/state /srv/projects/gx-cluster/secrets/control-ui
ReadWritePaths=/srv/projects/gx-cluster/media /srv/projects/gx-cluster/secrets/hf /srv/models
ReadWritePaths=@REPO@/legenex/models @REPO@/legenex/gateway/llama-swap/node01.yaml @REPO@/legenex/gateway/llama-swap/node02.yaml @REPO@/legenex/lifecycle/gx-max.conf
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
