# Copy to .env next to docker-compose.computer.yml if you need to override.
# No secrets belong here. LiteLLM and Computer gateway keys are entered in the UI.

GX_COMPUTER_IMAGE=ghcr.io/open-webui/computer:0.9.21
GX_COMPUTER_TS_BIND=100.105.214.61
GX_COMPUTER_PORT=8000
GX_COMPUTER_PROJECTS=/home/legenex/Documents/Projects/Server
GX_GROK_BIN=/home/legenex/.local/bin/grok
GX_COMPUTER_HIDDEN_ENV=./env.hidden
GX_NET_NAME=gx_gateway
GX_COMPUTER_MEM_LIMIT=2g
# Every origin used to open Computer (Socket.IO chat streaming rejects others).
# GX_COMPUTER_CORS_ORIGINS=http://100.105.214.61:8000,http://127.0.0.1:8000,http://localhost:8000,http://gx10-01:8000,http://<magicdns-fqdn>:8000
