{
  "name": "gx-playground",
  "version": "1.0.0",
  "private": true,
  "description": "GX-Playground creative web app (dev tooling only; the app has no runtime npm dependencies)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-check.mjs",
    "test:unit": "python3 -m unittest discover -s tests",
    "test:e2e": "playwright test --project=offline",
    "test:live": "playwright test --project=live",
    "qa": "bash scripts/qa.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  }
}
