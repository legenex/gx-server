# Env for the gx-mini llama.cpp container.
# Qwen3.5 emits chain-of-thought unless the chat template is told not to.
# Kept in an env-file because the value contains JSON quotes, which do not
# survive llama-swap's shell-style command tokenisation.
GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
LLAMA_ARG_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
