# Env for the gx-reason llama.cpp container (node 2).
# Qwen3.5 emits chain-of-thought into reasoning_content unless the chat
# template is told not to think; without this the model burns its whole output
# budget thinking and returns empty content. Kept in an env-file because the
# JSON quotes do not survive llama-swap's command tokenisation.
GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
LLAMA_ARG_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
