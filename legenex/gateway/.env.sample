# ==============================================================================
# gx cluster gateway — environment sample
# ==============================================================================
# Copy to `.env` IN THIS DIRECTORY and fill in. `.env` must never be committed.
#
#   cd legenex/gateway && cp .env.sample .env && chmod 600 .env && $EDITOR .env
#
# THIS FILE CONTAINS NO REAL SECRETS AND MUST NEVER CONTAIN ANY.
# Placeholder values are literally the word CHANGEME. Every variable marked
# REQUIRED has no default: docker compose refuses to start without it, which is
# deliberate — the stack fails closed rather than booting with a weak default.
#
# Never put a credential in a URL. DATABASE_URL is assembled by
# docker-compose.gateway.yml from POSTGRES_USER / POSTGRES_PASSWORD so the
# password exists in exactly one place.
# ==============================================================================


# ------------------------------------------------------------------------------
# SECRETS — REQUIRED
# ------------------------------------------------------------------------------

# LiteLLM master key. Every API call to the gateway needs
# `Authorization: Bearer <this>` (or a virtual key minted from it in the UI).
# LiteLLM expects the `sk-` prefix.
#   Generate:  printf 'sk-%s\n' "$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=CHANGEME

# Bearer token llama-swap requires on its inference endpoints, on BOTH nodes.
# Use the same value on gx10-01 and gx10-02 so LiteLLM needs one credential.
# If unset, llama-swap refuses to start (fail closed, by design).
#   Generate:  printf 'sk-%s\n' "$(openssl rand -hex 32)"
GX_SWAP_API_KEY=CHANGEME

# Postgres password for the LiteLLM database.
#   Generate:  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGEME

# LiteLLM admin UI login. Passed to the container as UI_USERNAME / UI_PASSWORD
# and deliberately NOT referenced from litellm/config.yaml, so the config file
# can never leak them. The UI shares port 4000 with the API — keep
# GX_LITELLM_BIND on loopback or Tailscale.
LITELLM_UI_USERNAME=CHANGEME
LITELLM_UI_PASSWORD=CHANGEME


# ------------------------------------------------------------------------------
# SECRETS — OPTIONAL (depend on components owned by other agents)
# ------------------------------------------------------------------------------

# Bearer token for the lead's orchestrator on :18900 (used by gx-max and
# gx-auto). Leave as-is if the orchestrator does not authenticate; set it once
# the lead confirms its contract.
GX_ORCHESTRATOR_API_KEY=not-required

# Bearer token for the node-2 ComfyUI/media router on :18800 (gx-image,
# gx-video). PENDING: that router is being specified by another agent.
GX_MEDIA_API_KEY=not-required


# ------------------------------------------------------------------------------
# NETWORK EXPOSURE — the main security knob
# ------------------------------------------------------------------------------
# Defaults are loopback-only. Nothing in this stack should be published to the
# LAN. To reach the gateway from another machine, set GX_LITELLM_BIND to THIS
# HOST'S TAILSCALE ADDRESS (management plane). Model traffic between the two
# nodes is separate and always uses the ConnectX/RoCE fabric (192.168.100.x),
# configured inside litellm/config.yaml, not here.

# Address LiteLLM's port is published on. 127.0.0.1 | <tailscale-ip> | 0.0.0.0
GX_LITELLM_BIND=127.0.0.1
# Host port for the gateway. Container port is always 4000.
GX_LITELLM_PORT=4000

# llama-swap control API + admin UI. It mounts the docker socket, so this is a
# root-equivalent surface. Keep it on loopback.
GX_SWAP_BIND=127.0.0.1
GX_SWAP_PORT=28080

# gx-mini's proven direct endpoint (http://127.0.0.1:19001/v1). Published from
# the llama-swap container because spawned model containers share its network
# namespace. Keep on loopback; normal clients should use the gateway on :4000.
GX_MINI_BIND=127.0.0.1
GX_MINI_PORT=19001

# Postgres. Always loopback; only the address is fixed, the port is yours.
GX_PG_PORT=15432

# Docker network name for this stack. Compose creates and owns it.
GX_NET_NAME=gx_gateway


# ------------------------------------------------------------------------------
# PATHS
# ------------------------------------------------------------------------------
# Host model root, mounted READ-ONLY into llama-swap at /models. The llama-swap
# configs address weights through their own `models_root` macro, which must
# point at the same tree.
#   node 1 verified layout: /srv/models/gguf/Qwen3.5-4B/{Qwen3.5-4B-Q4_K_M.gguf,mmproj-BF16.gguf}
GX_MODELS_ROOT=/srv/models


# ------------------------------------------------------------------------------
# IMAGES
# ------------------------------------------------------------------------------
# LiteLLM. Pin a digest or an explicit tag for production rather than a moving
# one, so a redeploy cannot silently change gateway behaviour.
GX_LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable

# Postgres.
GX_POSTGRES_IMAGE=postgres:16-alpine

# llama-swap. The upstream image has no docker CLI and therefore cannot spawn
# model containers; this tag is produced from the repo's own Dockerfile:
#   docker compose -f docker-compose.gateway.yml build llama-swap-node01
GX_LLAMA_SWAP_IMAGE=gx-llama-swap:latest

# NOT SET HERE (pending): the vLLM images and checkpoint paths for gx-fast and
# gx-reason. Those live as macros inside llama-swap/node01.yaml and
# llama-swap/node02.yaml, next to the flags they belong to. See README "Pending".


# ------------------------------------------------------------------------------
# RESOURCE CAPS
# ------------------------------------------------------------------------------
# Both nodes are 128 GB UNIFIED memory: CPU and GPU allocations compete for the
# same bytes, so the control plane gets hard caps. These are for the gateway
# services only — model memory is budgeted inside the llama-swap configs.
GX_LITELLM_MEM_LIMIT=2g
GX_PG_MEM_LIMIT=1g
GX_SWAP_MEM_LIMIT=512m

# Host-resilience hardening (added 2026-09-14, after the gx10-02 mmap-thrash
# incident - see coordination/BLOCKERS.md B-012). oom_score_adj biases the
# kernel's OOM killer (-1000..1000, higher = killed first) to sacrifice these
# containers before sshd/tailscaled/systemd/NetworkManager, which run outside
# Docker at the host default of 0 and cannot be given OOM protection without
# root on this host (verified: their cgroup files are root-owned 644 - see
# the host-resilience writeup for the full evidence). These three are all
# small (mem_limit above) and matter operationally, so they get a mild value;
# the model tiers (gx-mini/gx-fast/gx-reason/gx-max) get 700-950 - see
# legenex/gateway/llama-swap/node01.yaml, node02.yaml, legenex/lifecycle/gx-max.conf.
GX_LITELLM_OOM_SCORE_ADJ=100
GX_PG_OOM_SCORE_ADJ=100
GX_SWAP_OOM_SCORE_ADJ=100

# Minimum system memory that must stay free on this node during normal
# operation (i.e. NOT while gx-max is deliberately monopolising it - see
# gx-max.conf). This is informational/documentation here: the actual
# pre-launch check belongs to legenex/orchestrator's admission control, and
# legenex/host/gx-hostwatch.sh reads this same 30 GiB default independently
# for its own read-only alerting (GX_HOSTWATCH_MIN_FREE_GIB overrides it
# there; the two are not currently wired to share one value - see the
# host-resilience writeup's integration-point note).
GX_HOST_MIN_FREE_GIB=30


# ------------------------------------------------------------------------------
# DATABASE (non-secret parts)
# ------------------------------------------------------------------------------
POSTGRES_DB=litellm
POSTGRES_USER=litellm


# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Prompt and completion bodies are never logged
# (turn_off_message_logging in litellm/config.yaml) regardless of this setting.
LITELLM_LOG_LEVEL=INFO

# Tailscale address of THIS host, so remote clients can reach the gateway over
# the tailnet. Leave as 127.0.0.1 to keep the gateway loopback-only.
# Never set this to 0.0.0.0 - that exposes the gateway to the whole LAN.
GX_LITELLM_TS_BIND=127.0.0.1
