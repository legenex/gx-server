# ==============================================================================
# gx cluster gateway — environment sample (V4.1 rebuild, 2026-09-27)
# ==============================================================================
# Copy to `.env` IN THIS DIRECTORY and fill in. `.env` must never be committed.
#
#   cd legenex/gateway && cp .env.sample .env && chmod 600 .env && $EDITOR .env
#
# THIS FILE CONTAINS NO REAL SECRETS AND MUST NEVER CONTAIN ANY.
# Placeholder values are literally the word CHANGEME. Every variable marked
# REQUIRED has no default: docker compose refuses to start without it, which is
# deliberate — the stack fails closed rather than booting with a weak default.
#
# Never put a credential in a URL. DATABASE_URL is assembled by
# docker-compose.gateway.yml from POSTGRES_USER / POSTGRES_PASSWORD so the
# password exists in exactly one place.
#
# V4.1: the llama-swap variables (GX_SWAP_*, GX_MINI_*, GX_LLAMA_SWAP_IMAGE,
# GX_SWAP_API_KEY) and the media/voice keys are GONE with the retired stack.
# Model lifecycle is the orchestrator's, driving the Mia DeepSeek V4.1 Flash
# EXL3 kit (mia-dsv41). Old content: git tag pre-deepseek-v41-rebuild-20260927.
# ==============================================================================


# ------------------------------------------------------------------------------
# SECRETS — REQUIRED
# ------------------------------------------------------------------------------

# LiteLLM master key. Every API call to the gateway needs
# `Authorization: Bearer <this>` (or a virtual key minted from it in the UI).
# LiteLLM expects the `sk-` prefix.
#   Generate:  printf 'sk-%s\n' "$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=CHANGEME

# Postgres password for the LiteLLM database.
#   Generate:  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGEME

# LiteLLM admin UI login. Passed to the container as UI_USERNAME / UI_PASSWORD
# and deliberately NOT referenced from litellm/config.yaml, so the config file
# can never leak them. The UI shares port 4000 with the API — keep
# GX_LITELLM_BIND on loopback or Tailscale.
LITELLM_UI_USERNAME=CHANGEME
LITELLM_UI_PASSWORD=CHANGEME


# ------------------------------------------------------------------------------
# SECRETS — OPTIONAL (components owned by the orchestrator worker)
# ------------------------------------------------------------------------------

# Bearer key the orchestrator on :18900 REQUIRES on every route except /health
# (LiteLLM sends it for gx-max and gx-auto; the Control Center and the lifecycle
# scripts do too). With "not-required" the gateway still boots; the orchestrator
# decides what it accepts (fail closed on its side).
#   Generate: sk-orch-$(openssl rand -hex 32)
GX_ORCHESTRATOR_API_KEY=CHANGEME

# Virtual keys per consumer (hermes, open-webui, gx-computer) — with their
# rpms/parallel caps and model budgets — are managed in the LiteLLM DATABASE
# via the admin UI (127.0.0.1:4000/ui), not in this file. Trim each existing
# key's model list to {gx-max, gx-auto} after the first V4.1 deploy.


# ------------------------------------------------------------------------------
# V4.1 RUNTIME COORDINATES (safe defaults; consumed by the orchestrator on the
# host and, best-effort, by the gx_budget_hook inside the litellm container)
# ------------------------------------------------------------------------------

# The Mia kit's OpenAI API on the head node. LOOPBACK ONLY — never public,
# never in this file's bind settings. The orchestrator is the only client.
GX_MAX_BASE=http://127.0.0.1:8888/v1

# Served model id the Mia kit reports (registry runtimes.mia-dsv41.served_model_id).
GX_MAX_MODEL_ID=DeepSeek-v4.1-Flash-EXL3

# Path to the shipped registry.json (schema 2). The canonical copy lives in the
# checkout (legenex/models/registry.json); the state copy below is the
# deployment-stable path the hook and orchestrator read, refreshed with the
# checkout. The hook only uses it to size the context guard; a missing file
# falls back to GX_MAX_CONTEXT_TOKENS, then to the 262144 default.
GX_REGISTRY=/srv/projects/gx-cluster/state/registry.json

# Runtime state directory for the gateway/orchestrator plane (queue snapshots,
# metrics history). Created by the orchestrator; documented here so one file
# describes the whole deployment.
GX_RUNTIME_DIR=/srv/projects/gx-cluster/state

# ------------------------------------------------------------------------------
# NETWORK EXPOSURE — the main security knob
# ------------------------------------------------------------------------------
# Defaults are loopback-only. Nothing in this stack should be published to the
# LAN. To reach the gateway from another machine, set GX_LITELLM_BIND to THIS
# HOST'S TAILSCALE ADDRESS (management plane). Model/NCCL traffic between the
# nodes uses the ConnectX/RoCE fabric (192.168.100.x / 192.168.101.x) and is
# configured in the Mia kit + registry fabric block, not here.

# Address LiteLLM's port is published on. 127.0.0.1 | <tailscale-ip> | 0.0.0.0
GX_LITELLM_BIND=127.0.0.1
# Host port for the gateway. Container port is always 4000.
GX_LITELLM_PORT=4000

# Postgres. Always loopback; only the address is fixed, the port is yours.
GX_PG_PORT=15432

# Docker network name for this stack. Compose creates and owns it.
GX_NET_NAME=gx_gateway


# ------------------------------------------------------------------------------
# IMAGES
# ------------------------------------------------------------------------------
# LiteLLM. Pin a digest or an explicit tag for production rather than a moving
# one, so a redeploy cannot silently change gateway behaviour.
GX_LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable

# Postgres.
GX_POSTGRES_IMAGE=postgres:16-alpine


# ------------------------------------------------------------------------------
# RESOURCE CAPS
# ------------------------------------------------------------------------------
# Both nodes are 128 GB UNIFIED memory: CPU and GPU allocations compete for the
# same bytes, so the control plane gets hard caps. These are for the gateway
# services only — model memory is budgeted by the orchestrator's resource
# guard and the Mia kit's own envelope (about 105 GiB per node at gx-max).
GX_LITELLM_MEM_LIMIT=2g
GX_PG_MEM_LIMIT=1g

# Host-resilience hardening (added 2026-09-14, after the gx10-02 mmap-thrash
# incident - see coordination/BLOCKERS.md B-012). oom_score_adj biases the
# kernel's OOM killer (-1000..1000, higher = killed first) to sacrifice these
# containers before sshd/tailscaled/systemd/NetworkManager, which run outside
# Docker at the host default of 0 and cannot be given OOM protection without
# root on this host. Both are small (mem_limit above) and matter operationally,
# so they get a mild value; the model runtime containers inside the Mia kit
# carry their own much higher score (--oom-score-adj 1000).
GX_LITELLM_OOM_SCORE_ADJ=100
GX_PG_OOM_SCORE_ADJ=100

# Minimum system memory that must stay free on the head node during normal
# operation (NOT while the two-node runtime is deliberately loaded). This is
# informational here: the actual pre-launch check belongs to the orchestrator's
# admission control, and legenex/host/gx-hostwatch.sh reads this same default
# independently for its own read-only alerting.
GX_HOST_MIN_FREE_GIB=30


# ------------------------------------------------------------------------------
# DATABASE (non-secret parts)
# ------------------------------------------------------------------------------
POSTGRES_DB=litellm
POSTGRES_USER=litellm


# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Prompt and completion bodies are never logged
# (turn_off_message_logging in litellm/config.yaml) regardless of this setting.
LITELLM_LOG_LEVEL=INFO

# Tailscale address of THIS host, so remote clients can reach the gateway over
# the tailnet. Leave as 127.0.0.1 to keep the gateway loopback-only.
# Never set this to 0.0.0.0 - that exposes the gateway to the whole LAN.
GX_LITELLM_TS_BIND=127.0.0.1
