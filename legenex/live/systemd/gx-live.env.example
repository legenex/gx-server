# ~/.config/gx-live/gx-live.env on gx10-02 -- NOT tracked. No secrets here:
# the API key is read from /srv/projects/gx-cluster/secrets/gx-live/api-key (0600)
# and the engine key from .../gx-live/engine-key (created on first start).
GX_LIVE_BINDS=127.0.0.1,192.168.100.11

# Optional overrides (code defaults shown):
#GX_LIVE_PORT=18850
#GX_LIVE_ENGINE_PORT=18851                 # engine; published on 127.0.0.1 only
#GX_LIVE_MODEL_DIR=/srv/models/live/MiniCPM-o-4_5
#GX_LIVE_IMAGE=gx-live-engine:minicpmo45-503e754-t214
#GX_LIVE_ENGINE_ESTIMATE_GIB=34            # measured footprint incl. load transient (liv.md)
#GX_LIVE_ENGINE_MEMORY_CAP=48g
#GX_LIVE_IDLE_UNLOAD_S=600
#GX_LIVE_SESSION_MAX_S=14400
#GX_LIVE_RECONNECT_GRACE_S=60
#GX_LIVE_DELEGATE_TIMEOUT_S=660
#GX_GUARD_RESERVE_GIB=30                   # may be raised, never lowered below 30
#GX_NODE2_PEERS=                           # plt.md section 5 (default map)
#GX_METRICS_FILE=/srv/logs/gx-live/metrics.jsonl
