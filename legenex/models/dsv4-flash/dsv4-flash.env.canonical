# dsv4-flash.env.canonical — the REAL serving values of the dsv4-flash kit (tracked, no secrets).
#
# start.sh reads this file, then an optional untracked ./.env (local
# overrides), and for every DSV4F_* key a value already present in the
# caller's environment WINS (the orchestrator passes only DSV4F_HEAD_GID /
# DSV4F_WORKER_GID). That is the opposite of the mia-dsv41 kit, whose `.env`
# silently overrode the orchestrator's per-rank GID resolution (D-051).
# Never put a GID pin in either file: the kernel moves the index across reboots.

# ---- identity ---------------------------------------------------------------
DSV4F_SERVED_MODEL_NAME=DeepSeek-V4-Flash-0731-abliterated
DSV4F_IMAGE=gx/dsv4-flash-vllm:0.25.1-b12x7dc6fb8f-fi0472b9b3-gx1
# Image id of the build above (build-image.sh). start.sh refuses to launch when
# either node holds a different image under that tag. Empty = not built yet.
DSV4F_IMAGE_ID=sha256:ce6ccb53ecc9362639da1f529e9161186e030176e6067ae4bf3503170e95fc87

# ---- topology (head gx10-01 = rank 0 + API, worker gx10-02 = rank 1) ---------
DSV4F_HEAD_IP=192.168.100.10
DSV4F_WORKER_IP=192.168.100.11
# Management SSH to the worker (LAN; fabric addresses refuse SSH).
DSV4F_WORKER_SSH=legenex-02@10.60.21.41
DSV4F_WORKER_HOME=/home/legenex-02
# Rail 1 only, like the proven V4.1 kit. NCCL_IB_HCA is a PREFIX filter: a
# name that matches nothing makes NCCL silently fall back to TCP sockets.
DSV4F_HEAD_IF=enp1s0f0np0
DSV4F_WORKER_IF=enp1s0f0np0
DSV4F_HEAD_IB=rocep1s0f0
DSV4F_WORKER_IB=rocep1s0f0
# Preferred RoCE v2 GID index; per-rank values are resolved live (start.sh /
# orchestrator) and only deviate when this index is not the rank's v2 entry.
DSV4F_GID_PREFERRED=3
# The head's OpenAI API: loopback only (the orchestrator proxies it).
DSV4F_API_HOST=127.0.0.1
DSV4F_PORT=8890
DSV4F_MASTER_PORT=29531
DSV4F_TP=2
DSV4F_NNODES=2

# ---- weights (they live on gx10-02; the head reads them over NFSv4, read-only)
DSV4F_WORKER_MODEL_DIR=/srv/models/dsv4-flash-0731-abliterated/21bd923c
DSV4F_MODEL_MOUNT=/model
DSV4F_NFS_IMAGE=dsv41-exl3-nfs:local
DSV4F_NFS_CONTAINER=dsv4f-nfs
DSV4F_HEAD_NFS_VOLUME=dsv4f-weights
DSV4F_NFS_CLIENT_OPTS=nfsvers=4.2,ro,nconnect=8,rsize=1048576,wsize=1048576,hard,timeo=600

# ---- serving shape (conservative first boot) ---------------------------------
DSV4F_MAX_MODEL_LEN=131072
DSV4F_MAX_NUM_SEQS=8
# DSpark k (num_speculative_tokens); must be <= 5 (dspark_block_size).
DSV4F_DSPARK_K=5
# Must be >= 8192 + max_num_seqs * (k - 1); empty = 8192 + seqs * (k + 1) (= 8240).
DSV4F_MAX_NUM_BATCHED_TOKENS=
DSV4F_KV_CACHE_DTYPE=fp8
DSV4F_BLOCK_SIZE=256
DSV4F_MOE_BACKEND=flashinfer_b12x
DSV4F_ENABLE_PREFIX_CACHING=1
DSV4F_FLASHINFER_AUTOTUNE=1
# Unified-memory pool per rank = util x MemTotal (121.6 GiB): 0.74 -> 90.0 GiB,
# i.e. ~79 GiB weights + ~11 GiB KV/workspace. Measured idle MemAvailable
# (V4 model down, 2026-10-15/16 lifecycle log): head 106.0-113.7 GiB, worker
# 115.0-117.2 GiB -> after load head 12.0-19.7, worker 21.0-23.2 GiB with the
# 4 GiB out-of-pool overhead. start.sh refuses a node that would end below the
# floor (tools/mem_budget.py), so a busy head is told to free memory first.
DSV4F_GPU_MEM_UTIL=0.74
DSV4F_RESIDENT_FLOOR_GIB=15
DSV4F_MEM_OVERHEAD_GIB=4
# 1 = a node below the floor after load fails the start (and is torn down).
DSV4F_FLOOR_ENFORCE=1

# ---- containers, caches, timeouts ---------------------------------------------
DSV4F_CONTAINER_HEAD=dsv4f-head
DSV4F_CONTAINER_WORKER=dsv4f-worker
# Per-node caches (HF, vLLM/torch compile, Triton, FlashInfer JIT), 0700.
DSV4F_CACHE_DIRNAME=.cache/gx-dsv4-flash
# Containers run as the service user, not root (caches stay owned by it).
DSV4F_RUN_AS_SERVICE_USER=1
DSV4F_READY_TIMEOUT=2400
DSV4F_HANG_SECONDS=900
DSV4F_SHM_SIZE=32g
# 1 = log a sha256 of the loaded layers.0 wo_b on every rank (overlay proof).
DSV4F_WOB_DIGEST=1
DSV4F_NCCL_DEBUG=WARN
