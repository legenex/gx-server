# ~/.config/gx-music/gx-music.env on gx10-02 -- NOT tracked. No secrets here:
# the API key is read from /srv/projects/gx-cluster/secrets/gx-music/api-key (0600).
#
# Leave GX_MUSIC_HOME unset once the node 2 mirror has the canonical
# legenex/music/ tree (the unit defaults to the checkout). While Stage A runs
# from staging it is:
#GX_MUSIC_HOME=/srv/projects/gx-music-staging/legenex/music
GX_MUSIC_ORCHESTRATOR_DIR=/home/legenex-02/Documents/Projects/Server/gx-cluster/legenex/orchestrator
GX_MUSIC_BINDS=127.0.0.1,192.168.100.11

# Free IDLE ComfyUI weights before loading music when admission refuses.
# Keep 0 until patches/gx-music-evict-via-router.patch is in Git and deployed
# (see LIFECYCLE_INTEGRATION.md). After that, delete this line (default is on).
GX_MUSIC_EVICT_COMFY_WEIGHTS=0

# Optional overrides (code defaults shown):
#GX_MUSIC_PORT=18820
#GX_MUSIC_ENGINE_PORT=18811            # always published on 127.0.0.1 only
#GX_MUSIC_DATA_ROOT=/srv/models/music-data
#GX_MUSIC_CHECKPOINTS=/srv/models/music/acestep/checkpoints
#GX_MUSIC_STATE_DIR=/srv/projects/gx-cluster/state/gx-music
#GX_GUARD_STATE_DIR=/srv/projects/gx-cluster/state/guard
#GX_GUARD_RESERVE_GIB=30
#GX_MUSIC_EVICT_REASON=0               # music never evicts gx-reason
#GX_MUSIC_GXMAX_HOLD=/srv/projects/gx-cluster/state/guard/node2.gxmax-hold
#GX_MUSIC_GXMAX_HOLD_TTL_S=1200
#GX_MUSIC_MEDIA_ROUTER_CONTAINER=gx-media-router   # only after the patch
