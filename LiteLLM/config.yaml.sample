      max_output_tokens: 32768

litellm_settings:
  # Complexity routing for model="auto_router1"/"auto" on ALL endpoints
  # (incl. /v1/responses). See LiteLLM/complexity_hook.py.
  callbacks: ["complexity_hook.proxy_handler_instance"]
  drop_params: true
  set_verbose: false
  request_timeout: 900
  merge_reasoning_content_in_choices: true
  stream: true
  # Prevent infinite loops during long code/numeric generation (bignum, loops, repeating digits).
  # Recommended by DGX Spark community (forums.developer.nvidia.com/t/374423).
  repetition_penalty: 1.02
  # Prevent LiteLLM from health-checking all models on startup —
  # that would trigger llama-swap to load every model simultaneously.
  health_check_interval: 0
  # Never silently route a failed request to a different model group.
  num_retries: 0
  fallbacks: []
# stream_timeout: 5
# database_url: "postgresql://litellm_admin:LiteLLM-PostGres-PW@litellm-db:5432/litellm"
