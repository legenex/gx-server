#LITELLM config.yaml
general_settings:
  # ===================================================
  # 🛡️ ADMIN UI (no master_key = API is open, UI still password-protected)
  # ===================================================
  # master_key enables Admin UI access. API calls still work without a key
  # (no Bearer token required for ai_agent_ha, HA integrations).
  master_key: "sk-your-litellm-master-key"
  ui_username: "admin"
  ui_password: "your-secure-ui-password"
  ui_access_mode: "admin_only"
  disable_master_key_return: true
  allow_model_creation: false

globalTTL: 600 # Keep all models alive for 5 hour of idle time

model_list:
  # ===================================================
  # AUTO ROUTERS
  # ===================================================
  # model="auto_router1" — complexity routing that WORKS on /v1/responses too.
  #
  # The native auto_router/complexity_router type only works on /v1/chat/completions
  # (OpenClaw 2026.5.28 only calls /v1/responses → 400). So auto_router1 is now a
  # REGULAR model (alias for the always-hot 4B, a safe fallback) and the complexity
  # routing is done by the pre-call hook complexity_hook.proxy_handler_instance
  # (registered under litellm_settings.callbacks), which fires on BOTH endpoints
  # and rewrites the model by tier: SIMPLE/MEDIUM/COMPLEX→4B, REASONING→27B.
  # Edit the tier→model map in LiteLLM/complexity_hook.py.
  - model_name: auto_router1
    litellm_params:
      model: openai/Qwen3.5-4B-Q4_K_M
      api_base: "http://llama-qwen35-4b:19001/v1"
      api_key: "sk-your-litellm-master-key"
      drop_params: true
      fake_stream: true   # non-streaming upstream → reliable tool-call parsing
      extra_body:
        enable_thinking: false
        chat_template_kwargs: {"enable_thinking": false}
    # Advertise the real context so clients (OpenClaw) budget correctly,
    # instead of LiteLLM's default. The 4B server runs 65536 tokens/slot.
    model_info:
      max_input_tokens: 65536
      max_output_tokens: 4096

  # Semantic intent router. Requires an embedding model/key; set OPENAI_API_KEY
  # in .env/docker-compose if you want to call model="semantic-router".
  - model_name: semantic-router
    litellm_params:
      model: auto_router/auto_router_1
      auto_router_config: |
        {
          "routes": [
            {
              "name": "Qwen3-Coder-Next-FP8-Dynamic",
              "description": "Coding, debugging, refactoring, and software architecture",
              "score_threshold": 0.72,
              "utterances": [
                "write code for [task]",
                "debug this error",
                "explain this stack trace",
                "refactor this function",
                "design a software architecture",
                "optimize this database query",
                "create a docker compose file",
                "fix this python script",
                "help me with a React component"
              ],
              "function_schemas": null,
              "llm": null,
              "metadata": {}
            },
            {
              "name": "Qwen3-VL-30B-A3B-Instruct-FP8",
              "description": "Vision and image-understanding requests",
              "score_threshold": 0.7,
              "utterances": [
                "what is in this image",
                "describe this picture",
                "read the text in this screenshot",
                "analyze this chart",
                "compare these images",
                "extract information from this photo"
              ],
              "function_schemas": null,
              "llm": null,
              "metadata": {}
            },
            {
              "name": "Qwen3.5-35B-A3B-FP8",
              "description": "General complex answers that need a larger text model",
              "score_threshold": 0.74,
              "utterances": [
                "write a long detailed answer",
                "summarize this long document",
                "compare these technical choices",
                "explain this complex topic",
                "create a comprehensive guide",
                "help me make a decision with pros and cons"
              ],
              "function_schemas": null,
              "llm": null,
              "metadata": {}
            }
          ]
        }
      auto_router_default_model: Qwen3.5-4B-Q4_K_M
      auto_router_embedding_model: text-embedding-3-small

  - model_name: text-embedding-3-small
    litellm_params:
      model: openai/text-embedding-3-small
      api_key: os.environ/OPENAI_API_KEY

  # ===================================================
  # 🦙 LLAMA-CPP MODELS (DGX Local)
  # ===================================================

  - model_name: Qwen3.5-4B-Q4_K_M
    litellm_params:
      model: openai/Qwen3.5-4B-Q4_K_M
      api_base: "http://llama-qwen35-4b:19001/v1"
      api_key: "sk-your-litellm-master-key"
      max_tokens: 4096
      drop_params: true
      # llama.cpp's STREAMING tool-call parser intermittently fails on complex
      # tool calls ("Failed to parse input at pos N"); its non-streaming parser
      # is reliable. fake_stream makes LiteLLM call llama.cpp non-streaming and
      # fake-stream the buffered result to the client → reliable tool calls.
      fake_stream: true
      extra_body:
        enable_thinking: false
        chat_template_kwargs: {"enable_thinking": false}

    # Dedicated llama.cpp on :19001 runs 65536 tokens/slot — advertise it
    # so OpenClaw budgets against the real window (not LiteLLM's default).
    model_info:
      max_input_tokens: 65536
      max_output_tokens: 4096

  # Qwen3.8-27B NVFP4 + DFlash2 via llama-swap/SGLang.
  - model_name: Qwen3.8-27B-NVFP4-DFlash2
    litellm_params:
      model: openai/Qwen3.8-27B-NVFP4-DFlash2
      api_base: "http://llama-swap:8080/v1"
      api_key: "sk-your-litellm-master-key"
      max_tokens: 32768
      drop_params: true
    model_info:
      # SGLang KV pool is 131072 tokens (--max-total-tokens); input + output
      # must fit inside it, so these two values sum to exactly that.
      max_input_tokens: 98304
      max_output_tokens: 32768

  # Always-on 27B llama.cpp GGUF service (manually started by Martin,
  # not managed by llama-swap) — used as the default "agent work" model.
  # Bypasses the vLLM/llama-swap adaptive-VRAM path entirely, so it isn't
  # subject to the GMEM_MIN floor failures the NVFP4 vLLM model groups hit.
  - model_name: Qwen3.6-27B-Uncensored-Q4_K
    litellm_params:
      model: openai/Qwen3.6-27B-Uncensored-Q4_K
      api_base: "http://<LAN_HOST_IP>:19002/v1"
      api_key: "sk-your-litellm-master-key"
      max_tokens: 4096
      drop_params: true
      fake_stream: true
      extra_body:
        enable_thinking: false
        chat_template_kwargs: {"enable_thinking": false}
    model_info:
      max_input_tokens: 65536
      max_output_tokens: 4096

  # Same always-on 4B llama.cpp service, addressed via the LAN URL.
  # Used as a last-resort LiteLLM fallback when llama-swap/vLLM models fail.
  - model_name: Qwen3.5-4B-Q4_K_M-always-on
    litellm_params:
      model: openai/Qwen3.5-4B-Q4_K_M
      api_base: "http://llama-qwen35-4b:19001/v1"
      api_key: "sk-your-litellm-master-key"
      max_tokens: 4096
      drop_params: true
      fake_stream: true
      extra_body:
        enable_thinking: false
        chat_template_kwargs: {"enable_thinking": false}
    model_info:
      max_input_tokens: 65536
      max_output_tokens: 4096

#  - model_name: Nemotron-3-Nano-4B-Q4_K_M-GGUF
#    litellm_params:
#      model: openai/Nemotron-3-Nano-4B-Q4_K_M-GGUF 
#      api_base: "http://ollama:11434/v1"
#    # api_base: "http://llama-swap:8080/v1"
#      api_key: "sk-your-litellm-master-key"

#  - model_name: GLM-Steam-106B-A12B-v1-Q4_K_M-GGUF
#    litellm_params:
#      model: openai/TheDrummer_GLM-Steam-106B-A12B-v1-Q4_K_M-GGUF
#      api_base: "http://ollama:11434/v1"
#    # api_base: "http://llama-swap:8080/v1"
#      api_key: "sk-your-litellm-master-key"

#  - model_name: Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive
#    litellm_params:
#      model: openai/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive
#    # api_base: "http://ollama:11434/v1"
#      api_base: "http://llama-swap:8080/v1"
#      api_key: "sk-your-litellm-master-key"
#   #  max_tokens: 4096
#      max_tokens: 32768
#      drop_params: true
#    model_info:
#      max_input_tokens: 65536
#      max_output_tokens: 32768

  - model_name: Qwen3.5-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_M
    litellm_params:
      model: openai/Qwen3.5-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_M
      api_base: "http://llama-swap:8080/v1"
      api_key: "sk-your-litellm-master-key"
      max_tokens: 8192
      drop_params: true
    model_info:
      max_input_tokens: 32768
      max_output_tokens: 8192


  # ===================================================
  # 🦙 LLAMA-SWAP MODELS (DGX Local)
  # ===================================================

  # --- DeepSeek V4 Flash IQ2XXS (DS4 GGUF server) ---
  - model_name: DeepSeek-V4-Flash-IQ2XXS-DS4
    litellm_params:
      model: openai/DeepSeek-V4-Flash-IQ2XXS-DS4
      api_base: "http://llama-swap:8080/v1"
      api_key: "sk-your-litellm-master-key"
      drop_params: true
      include_reasoning: true
      supports_reasoning: true
      merge_reasoning_content_in_choices: true
      max_tokens: 8192
      extra_body:
        temperature: 1.0
        top_p: 1.0
        thinking: true

# --- Qwen 3.5 Series (Native Reasoning) ---
  - model_name: Qwen3.5-35B-A3B-FP8
    litellm_params:
      model: openai/Qwen3.5-35B-A3B-FP8
      api_base: "http://llama-swap:8080/v1"
      api_key: "sk-your-litellm-master-key" 
      drop_params: true
      include_reasoning: true 
      supports_reasoning: true
      # This ensures the <think> tags stay in the text stream
      merge_reasoning_content_in_choices: true
      extra_body:
        enable_thinking: true  # Specific for Qwen 3.5 vLLM deployments
        chat_template_kwargs: {"enable_thinking": true}
      max_tokens: 4096 # Changed from 8192 to allow more input tokens

# --- Qwen 3.6 Series ---
