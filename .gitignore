# --- Runtime Logs & State ---
logs/

# Resource-guard runtime state (node locks + residency ledgers) --
# see legenex/lifecycle/resource-guard.sh. Per-node, regenerated, never
# meaningful to commit.
legenex/lifecycle/.state/

# --- Setup Output (auto-generated, not tracked) ---
setup/SETUP_SUMMARY.txt

# --- IDE & Tool Config ---
.claude/

# --- Backup/Temp Files ---
*~
*.swp
*.log
*.bak*
.DS_Store
*klappt nicht so ganz*
*.gemini.created
# VSCode / IDE temp files with control-character names:
$'\001'*
STACK_ERKLÄRUNG.md
SONARQUBE-LLM-GUIDE.md

# --- Personal Notes (local only) ---
todo.md
TODO.md

# Status written by the gx10-02 worker agent (not canonical)
coordination/node2/

# ============================================================================
# Public-repository hardening (D-026, 2026-09-16). This checkout is synced
# automatically to a PUBLIC GitHub repository. Git holds code, config
# templates and documentation only. Mutable runtime state lives under
# /srv/projects/gx-cluster/{state,runtime,secrets}; logs under /srv/logs.
# ============================================================================
# --- secrets / credentials ---
*.env
!*.env.sample
!*.env.example
!*.env.template
!legenex/gateway/llama-swap/env/*.env
.env.*
!.env.sample
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
*.kubeconfig
secrets/
.secrets/
*.token
credentials*.json
.netrc
.git-credentials
